# Copy to .env and fill in real values. (.env itself is git-ignored.)

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dsdb
DB_USER=root
DB_PASSWORD=

# Built-in admin login - CHANGE THE PASSWORD
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Signs login tokens; keep it stable so logins survive restarts
SECRET_KEY=change-me-to-a-long-random-string

# Front-end origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

PORT=5000

# Set to 1 if your dataset labels disease as output=1 (the standard heart.csv does not)
OUTPUT_1_MEANS_DISEASE=0